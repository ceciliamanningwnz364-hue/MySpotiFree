name: Build Volna IPA
on:
  workflow_dispatch:
  push:
    paths:
      - '.github/workflows/build.yml'
permissions:
  contents: read
jobs:
  build:
    runs-on: macos-15
    timeout-minutes: 25
    steps:
      - name: Restore Volna sources
        env:
          VOLNA_SOURCE:   
        run: |
          python3 - <<'PYTHON'
          import os, io, base64, zipfile
          with zipfile.ZipFile(io.BytesIO(base64.b64decode(os.environ['VOLNA_SOURCE']))) as archive:
              archive.extractall('source')
          PYTHON
      - name: Install XcodeGen
        run: brew install xcodegen
      - name: Generate Xcode project
        working-directory: source
        run: xcodegen generate
      - name: Build for iPhone
        working-directory: source
        run: >-
          xcodebuild -project Volna.xcodeproj -scheme Volna
          -configuration Release -sdk iphoneos -destination 'generic/platform=iOS'
          -derivedDataPath build CODE_SIGNING_ALLOWED=NO build
      - name: Package unsigned IPA
        run: |
          mkdir -p output/Payload
          cp -R source/build/Build/Products/Release-iphoneos/Volna.app output/Payload/
          cd output
          zip -r Volna-unsigned.ipa Payload
      - name: Upload IPA
        uses: actions/upload-artifact@v4
        with:
          name: Volna-unsigned-needs-signing
          path: output/Volna-unsigned.ipa
          if-no-files-found: error
      - name: Upload source project
        uses: actions/upload-artifact@v4
        with:
          name: Volna-source
          path: |
            source/Volna
            source/project.yml
            source/README.md
